{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // `event` is a hook payload this package does not import types for: the
    // public entry exports `Plugin.Context`, not the session hook interfaces.
    // Everything else stays checked, which is where the real mistakes were.
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}

{
  "name": "opencode-desktop-markdown-colors",
  "version": "0.1.0",
  "description": "CLI-style markdown colors for OpenCode Desktop: headings, inline code, links, lists and quotes follow the active theme.",
  "license": "MIT",
  "author": "odt1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odt1/opencode-extensions-by-odt.git",
    "directory": "packages/opencode-desktop-markdown-colors"
  },
  "homepage": "https://github.com/odt1/opencode-extensions-by-odt/tree/main/packages/opencode-desktop-markdown-colors#readme",
  "bugs": {
    "url": "https://github.com/odt1/opencode-extensions-by-odt/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist/gui-experimental.cjs",
    "src/index.js",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "markdown",
    "theme",
    "colors"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && (node ../../script/check-dist.mjs dist)"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}

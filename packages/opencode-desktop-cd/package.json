{
  "name": "opencode-desktop-cd",
  "version": "0.1.0",
  "description": "Add /cd to OpenCode Desktop: move the current session to another directory, and with it to that directory's project.",
  "license": "MIT",
  "author": "odt1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odt1/opencode-extensions-by-odt.git",
    "directory": "packages/opencode-desktop-cd"
  },
  "homepage": "https://github.com/odt1/opencode-extensions-by-odt/tree/main/packages/opencode-desktop-cd#readme",
  "bugs": {
    "url": "https://github.com/odt1/opencode-extensions-by-odt/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist/gui-experimental.cjs",
    "src/index.js",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "cd",
    "working-directory",
    "session",
    "project"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && (test -z \"$(git status --porcelain -- dist/)\" || (echo 'dist/ is stale or untracked: commit the rebuilt bundle before publishing' && exit 1))"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.3.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  }
}
